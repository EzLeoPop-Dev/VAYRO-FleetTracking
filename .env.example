# Optional local host ports. Copy to .env to override.
WEB_PORT=3000
GATEWAY_PORT=3001
AUTH_PORT=3002
USER_PORT=3003
TRACKING_PORT=3004
# Device ingestion credentials only. Human users log in through /api/v1/auth/login.
TRACKING_API_TOKENS={}

# Local dev only. Replace both before any shared or real deployment.
POSTGRES_PASSWORD=vayro_dev_only_change_me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Shared by every service for calls between them (/internal/*). At least 32 characters; never exposed to browsers.
INTERNAL_API_TOKEN=dev-only-internal-token-change-me-0123456789abcdef

# Encrypts GPS provider credentials stored by gps-device-service (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it: credentials saved with one key cannot be read with another. Leave empty to refuse saving credentials.
CREDENTIALS_ENCRYPTION_KEY=

# Optional: services that should be sent every new GPS point (comma separated base URLs). See services/gps-data-service/README.md.
GPS_EVENT_SUBSCRIBERS=

# Set to true when the web app is served over HTTPS (marks session cookies Secure).
COOKIE_SECURE=false
