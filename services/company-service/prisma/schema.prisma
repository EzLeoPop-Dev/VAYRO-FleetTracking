// company-service owns company (the workspace of each customer). Database: company_db.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  pending
  active
  suspended
  rejected

  @@map("workspace_status")
}

model Company {
  company_id       BigInt          @id @default(autoincrement())
  company_name     String          @db.VarChar(150)
  workspace_status WorkspaceStatus @default(pending)
  contact_name     String?         @db.VarChar(100)
  contact_email    String?         @unique @db.VarChar(150)
  contact_phone    String?         @db.VarChar(30)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("company")
}

// Audit trail of this service only. Never store secrets in old_value/new_value.
model SystemLog {
  system_log_id BigInt   @id @default(autoincrement())
  company_id    BigInt?
  user_id       BigInt?
  action        String   @db.VarChar(120)
  entity_type   String?  @db.VarChar(80)
  entity_id     String?  @db.VarChar(80)
  old_value     Json?
  new_value     Json?
  result        String   @default("success") @db.VarChar(10)
  ip_address    String?  @db.VarChar(45)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([company_id, created_at], map: "system_log_company_idx")
  @@map("system_log")
}
